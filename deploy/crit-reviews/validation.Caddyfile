# Append to the existing authoritative chezmoi Caddyfile; retain every existing
# block including crit.wharfi.sh and preview.crit.wharfi.sh unchanged.
# No compression here: stream Crit SSE through both proxy hops promptly.
validation.crit.wharfi.sh {
    bind 100.81.54.26
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
        resolvers 1.1.1.1 8.8.8.8
    }
    reverse_proxy 127.0.0.1:17466 {
        flush_interval -1
    }
}

*.crit.wharfi.sh {
    bind 100.81.54.26
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
        resolvers 1.1.1.1 8.8.8.8
    }
    reverse_proxy 127.0.0.1:17466 {
        flush_interval -1
    }
}
